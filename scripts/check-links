#!/usr/bin/env python3
"""Check that relative Markdown links resolve."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import argparse, dpp


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("root", nargs="?", default=".", help="folder to check (default: .)")
    ap.add_argument("--report-unselected", action="store_true", help="also warn about links to framework documents your project did not select")
    ap.add_argument("--strict", action="store_true", help="treat warnings as errors")
    a = ap.parse_args()
    r = dpp.Report()
    stems = {x["_stem"] for x in dpp.collect_catalog(dpp.framework_root())}
    dpp.check_links(a.root, r, stems if os.path.abspath(a.root) != dpp.framework_root() else None, a.report_unselected)
    sys.exit(r.finish("check-links", a.strict))

main()
